classDiagram
    class Owner {
        +str name
        +str preferred_species
        +list pets
        +add_pet(pet)
        +get_all_tasks() list
    }
    class Pet {
        +str name
        +str species
        +list tasks
        +add_task(task)
        +mark_task_complete(task_id)
    }
    class Task {
        +str description
        +str time
        +date due_date
        +int duration_minutes
        +str priority
        +str frequency
        +bool completed
        +mark_complete()
    }
    class Scheduler {
        +Owner owner
        +sort_by_time() list
        +filter_tasks() list
        +detect_conflicts() list
        +build_plan() tuple
    }
    Owner "1" o-- "0..*" Pet : cares for
    Pet "1" *-- "0..*" Task : tracks
    Scheduler --> Owner : reads tasks
